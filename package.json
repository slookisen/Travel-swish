{
  "name": "travel-swipe",
  "private": true,
  "version": "0.6.0",
  "type": "module",
  "scripts": {
    "gen:buildmeta": "node ./tools/gen-build-meta.mjs",
    "predev": "npm run gen:buildmeta",
    "dev": "vite",
    "prebuild": "npm run gen:buildmeta",
    "build": "vite build",
    "postbuild": "node ./tools/normalize-built-html.mjs",
    "build:mobile": "npm run gen:buildmeta && vite build --base ./",
    "preview": "vite preview --port 4173",
    "test:smoke": "node ./tools/smoke-check.mjs",
    "test:profile": "node ./tools/profile-engine-check.mjs",
    "test:cards": "node ./tools/card-audit.mjs",
    "typecheck": "tsc --noEmit",
    "test:pwa": "node ./tools/pwa-check.mjs",
    "check": "npm run typecheck && npm run test:cards && npm run test:profile && npm run build && npm run test:pwa",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "cap:sync": "npm run build:mobile && cap sync && npm run fix:ios-spm",
    "cap:android": "npm run cap:sync && cap open android",
    "cap:ios": "npm run cap:sync && cap open ios",
    "assets:generate": "powershell -ExecutionPolicy Bypass -File ./tools/generate-app-assets.ps1",
    "fix:ios-spm": "node ./tools/fix-capacitor-ios-spm.mjs",
    "cards:gen": "node ./tools/generate-v2-cards.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.5.0",
    "@capacitor/core": "8.5.0",
    "@capacitor/ios": "8.5.0",
    "@capacitor/share": "8.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@capacitor/cli": "8.4.2",
    "@playwright/test": "^1.55.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.3",
    "vite": "^6.4.3"
  }
}
